@article{bariego2026sparc,
  abbr        = {New Astron.},
  bibtex_show = {true},
  title       = {{No evidence for Keplerian taper of far-out galactic rotation in the SPARC galaxy database}},
  author      = {Bariego-Quintana, Adriana and Llanes-Estrada, Felipe J.},
  journal     = {New Astronomy},
  volume      = {126},
  pages       = {102537},
  year        = {2026},
  doi         = {10.1016/j.newast.2026.102537},
  html        = {https://doi.org/10.1016/j.newast.2026.102537},
  arxiv       = {2507.12120},
  abstract    = {Statistical analysis of 175 rotation curves from the SPARC database, testing whether galactic rotation velocities taper off in a Keplerian way at large radii. The data are compatible with the null hypothesis of no taper and no decline; the Milky Way instead shows a decline of about 20\%, suggesting it may not be typical.}
}

@article{bariego2024haloes,
  abbr        = {ICWIP},
  bibtex_show = {true},
  selected    = {true},
  title       = {{How Stellar Stream Torsion may reveal aspherical Dark Matter Haloes}},
  author      = {Bariego-Quintana, Adriana},
  journal     = {Proceedings of the 8th International Conference on Women in Physics (ICWIP 2023)},
  year        = {2024},
  arxiv       = {2405.09678},
  abstract    = {Stellar streams would lie on a plane if the dark matter halo's gravitational field were spherically symmetric. An aspherical field torsions them out of that plane, which makes torsion a direct probe of halo shape. Milky Way streams show torsion well above the spherical expectation.}
}

