@article{bariego2024torsion,
  abbr        = {A&A},
  bibtex_show = {true},
  selected    = {true},
  title       = {{The torsion of stellar streams and the overall shape of galactic gravity's source}},
  author      = {Bariego-Quintana, Adriana and Llanes-Estrada, Felipe J.},
  journal     = {Astronomy \& Astrophysics},
  volume      = {687},
  pages       = {A46},
  year        = {2024},
  doi         = {10.1051/0004-6361/202347502},
  html        = {https://doi.org/10.1051/0004-6361/202347502},
  arxiv       = {2307.07402},
  abstract    = {Flat rotation curves are naturally explained by elongated dark matter distributions. We introduce the torsion of a stellar stream as a local observable that measures deviation from planarity, and show that central forces produce negligible torsion while distorted haloes generate measurable values. Milky Way streams at large galactocentric distances show torsion much larger than expected for a spherical bulb alone.}
}

