@article{bariego2023prolate,
  abbr        = {PRD},
  bibtex_show = {true},
  title       = {{Galaxy rotation favors prolate dark matter haloes}},
  author      = {Bariego-Quintana, Adriana and Llanes-Estrada, Felipe J. and Manzanilla Carretero, Oliver},
  journal     = {Physical Review D},
  volume      = {107},
  number      = {8},
  pages       = {083524},
  year        = {2023},
  doi         = {10.1103/PhysRevD.107.083524},
  html        = {https://doi.org/10.1103/PhysRevD.107.083524},
  arxiv       = {2204.06384},
  abstract    = {The constant rotation velocity of spiral galaxies matches Kepler's law in reduced dimensions, which is naturally explained by elongated dark matter distributions perpendicular to the galactic plane. Fits to rotation curves give better chi-squared for prolate than for spherical haloes, and most galaxies in the database come out prolate. This has direct consequences for estimates of the dark matter density near the Earth.}
}
 
@article{bariego2022sparcfits,
  abbr        = {PoS},
  bibtex_show = {true},
  title       = {{Dark-matter prolate halo shapes from fits to SPARC galaxy rotation curves}},
  author      = {Bariego-Quintana, Adriana and Llanes-Estrada, Felipe J. and Manzanilla Carretero, Oliver},
  journal     = {Proceedings of Science (EPS-HEP2021)},
  pages       = {137},
  year        = {2022},
  doi         = {10.22323/1.398.0137},
  html        = {https://doi.org/10.22323/1.398.0137},
  arxiv       = {2109.11153},
  abstract    = {Rotation curves from the SPARC database are fitted with multipole dark matter density distributions. Prolate haloes fit markedly better than spherically symmetric ones, and the fitted ellipticities exceed those of cosmological simulations. If the Milky Way's halo resembles the SPARC population, the local dark matter density may currently be overestimated by a factor of two.}
}
 
